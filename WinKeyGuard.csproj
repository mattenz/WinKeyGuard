<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Change to net8.0-windows if that is the SDK you have installed -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinKeyGuard</RootNamespace>

    <!-- EXE icon and version info (shown in Explorer / Task Manager) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>WinKeyGuard</AssemblyTitle>
    <Product>WinKeyGuard</Product>
    <Description>Disables the Keychron Windows keys while a game has focus</Description>
    <Version>1.1.0</Version>

    <!-- Size trimming that is safe for WinForms -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets\tray-enabled.ico" LogicalName="tray-enabled.ico" />
    <EmbeddedResource Include="Assets\tray-disabled.ico" LogicalName="tray-disabled.ico" />
    <EmbeddedResource Include="Assets\tray-warn.ico" LogicalName="tray-warn.ico" />
  </ItemGroup>

</Project>
